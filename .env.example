# Required for the OpenAI API call
OPENAI_API_KEY=your_token_here

# Required for the Postgres connection
# For production, ensure SSL is enabled in your database
DATABASE_URL=your_db_connection_here

# Optional: Custom CA certificate for database SSL (if needed)
# DATABASE_CA_CERT=

# Optional override; defaults to gpt-4.1 if omitted
OPENAI_MODEL=your_model_here

# Required: API keys for authentication (comma-separated list)
# Generate strong random keys: openssl rand -base64 32
API_KEYS=your-secret-api-key-1,your-secret-api-key-2

# Optional: Allow public read access to eligibility records (default: false)
# Set to "true" to allow GET requests to /api/eligibility-records without authentication
ALLOW_PUBLIC_READ=false

# Optional: Google Custom Search Engine credentials (for web search feature)
GOOGLE_CSE_ID=your_google_cse_id_here
GOOGLE_CSE_KEY=your_google_cse_api_key_here